{
    "name": "rcis/local-checks",
    "description": "Local PHPCS, PHPMD and PHPCPD toolchain for the RCIS checks",
    "type": "project",
    "license": "MIT",
    "require-dev": {
        "phpmd/phpmd": "^3.0",
        "sebastian/phpcpd": "^6.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
