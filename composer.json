{
    "name": "rocs/rcis",
    "description": "RCIS Accoumnt Management System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "tools:install": "@composer install --working-dir=.github/tools/lint --no-interaction --no-progress",
        "ai": "@php .github/tools/slop/run.php --threshold 10 . build/reports/slop/ai-pattern-report.txt",
        "phpcs": "@php .github/tools/lint/vendor/bin/phpcs --standard=phpcs.xml",
        "checkstyle": "@phpcs",
        "phpmd": "@php .github/tools/lint/vendor/bin/phpmd analyze --format=text --ruleset=phpmd.xml --exclude=vendor/*,tests/* .",
        "phpcpd": [
            "@php -r \"@mkdir('build/reports', 0777, true);\"",
            "@php .github/tools/lint/vendor/bin/phpcpd --min-lines 5 --min-tokens 70 --exclude vendor --exclude tests --exclude .github --log-pmd build/reports/cpd-report.xml ."
        ],
        "check": [
            "@phpcs",
            "@phpmd",
            "@phpcpd",
            "@ai"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}